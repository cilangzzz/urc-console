{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URC Console",
  "version": "0.1.0",
  "identifier": "dev.urc.console",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "URC 控制台 — Steinberg UR22C",
        "width": 1060,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
